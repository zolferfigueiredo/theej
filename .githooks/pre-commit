#!/bin/sh
# Blocks direct commits to main: work on a branch and open a pull request.
# ./run.sh turns this on (core.hooksPath is local config, so it doesn't travel with a clone).
if [ "$(git symbolic-ref --short HEAD 2>/dev/null)" = "main" ]; then
    echo "Refusing to commit directly to main. Use a branch." >&2
    exit 1
fi
